{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Motion Site Page Plan",
  "type": "object",
  "required": ["subject", "audience", "page_job", "art_direction", "hero_contract", "visual_quality_contract", "regression_baseline", "integration_contract", "tokens", "sections", "breakpoints"],
  "properties": {
    "subject": {"type": "string", "minLength": 2},
    "audience": {"type": "string", "minLength": 2},
    "page_job": {"type": "string", "minLength": 2},
    "art_direction": {
      "type": "object",
      "required": ["thesis", "signature", "selected_type", "selected_layout", "selected_color"],
      "properties": {
        "thesis": {"type": "string"},
        "signature": {"type": "string"},
        "selected_type": {"type": "string"},
        "selected_layout": {"type": "string"},
        "selected_color": {"type": "string"}
      }
    },
    "hero_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "locked", "desktop_media_coverage_min", "copy_safe_zone", "subject_safe_zone", "interaction_safe_zone", "regeneration_policy", "mobile_transformation", "locked_fields"],
      "properties": {
        "mode": {"enum": ["cinematic-full-bleed", "near-full-bleed", "contained-explicit", "non-video-explicit"]},
        "locked": {"type": "boolean"},
        "desktop_media_coverage_min": {"type": "number", "minimum": 0, "maximum": 1},
        "copy_safe_zone": {"type": "string", "minLength": 4},
        "subject_safe_zone": {"type": "string", "minLength": 4},
        "interaction_safe_zone": {"type": "string", "minLength": 4},
        "regeneration_policy": {"enum": ["regenerate-before-layout-change", "user-approved-layout-change", "not-applicable"]},
        "mobile_transformation": {"type": "string", "minLength": 4},
        "locked_fields": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["hero_media_mode", "media_box", "subject_focal_zone", "section_structure", "macro_grid", "color_system", "motion_system"]}
        }
      }
    },
    "visual_quality_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hero_subject_signals", "unrelated_brand_substitution_passed", "neutral_material_area_target", "high_chroma_area_target", "max_consecutive_accent_dominant_sections", "fullpage_desktop_capture", "fullpage_phone_capture", "forbidden_failures"],
      "properties": {
        "hero_subject_signals": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 4}},
        "unrelated_brand_substitution_passed": {"const": true},
        "neutral_material_area_target": {"type": "number", "minimum": 0.5, "maximum": 0.95},
        "high_chroma_area_target": {"type": "number", "minimum": 0, "maximum": 0.3},
        "max_consecutive_accent_dominant_sections": {"type": "integer", "minimum": 0, "maximum": 1},
        "fullpage_desktop_capture": {"type": "string", "minLength": 1},
        "fullpage_phone_capture": {"type": "string", "minLength": 1},
        "forbidden_failures": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"enum": ["generic-hero", "unintended-single-character-line", "punctuation-only-line", "multi-screen-flat-accent", "uniform-section-silhouette", "media-subject-obstruction"]}}
      }
    },
    "regression_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "protected_qualities"],
      "properties": {
        "source": {"type": ["string", "null"]},
        "protected_qualities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "integration_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["art_direction_owner", "typography_specialist", "font_selection_owner", "font_family_lock_state", "typography_geometry_state", "expressive_distribution", "non_hero_expressive_targets", "reading_protected_targets", "layout_locked", "media_locked", "section_structure_locked", "allowed_typography_changes"],
      "properties": {
        "art_direction_owner": {"const": "motion-site-art-directed-v9"},
        "typography_specialist": {"enum": ["motion-site-chinese-web-design-v6", null]},
        "font_selection_owner": {"enum": ["motion-site-art-directed-v9", "motion-site-chinese-web-design-v6"]},
        "font_family_lock_state": {"enum": ["unlocked-for-typography-lab", "selected-from-rendered-evidence"]},
        "typography_geometry_state": {"enum": ["provisional-for-real-glyph-test", "locked-after-real-glyph-test"]},
        "expressive_distribution": {"enum": ["distributed", "concentrated", "restrained"]},
        "non_hero_expressive_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reading_protected_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "layout_locked": {"const": true},
        "media_locked": {"const": true},
        "section_structure_locked": {"const": true},
        "allowed_typography_changes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["font_files", "font_tokens", "font_metrics", "text_color_tokens", "line_break_proposals", "fallbacks", "copy_zone_width", "local_grid_span", "local_alignment", "section_padding", "section_min_height"]}
        }
      }
    },
    "tokens": {"type": "object"},
    "sections": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "content_source", "layout", "alignment", "type_roles", "expressive_type_opportunities", "reading_protected_surfaces", "surface_role", "media_role", "safe_zone", "layers", "responsive", "reduced_motion"],
        "properties": {
          "id": {"type": "string"},
          "purpose": {"type": "string"},
          "content_source": {"type": "string"},
          "layout": {"type": "string"},
          "alignment": {"enum": ["left", "right", "center", "edge", "bottom", "grid", "mixed"]},
          "type_roles": {"type": "array", "items": {"type": "string"}},
          "expressive_type_opportunities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "reading_protected_surfaces": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "surface_role": {"type": "string"},
          "media_role": {"type": ["string", "null"]},
          "safe_zone": {"type": ["string", "null"]},
          "layers": {"type": "object"},
          "responsive": {"type": "object"},
          "reduced_motion": {"type": "string"},
          "claim_status": {"enum": ["sourced", "user-provided", "editorial", "unknown", "not-applicable"]}
        }
      }
    },
    "breakpoints": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"integration_contract": {"properties": {"typography_specialist": {"const": "motion-site-chinese-web-design-v6"}}}}},
      "then": {"properties": {"integration_contract": {"properties": {"font_selection_owner": {"const": "motion-site-chinese-web-design-v6"}}}}}
    },
    {
      "if": {"properties": {"integration_contract": {"properties": {"expressive_distribution": {"const": "distributed"}}}}},
      "then": {"properties": {"integration_contract": {"properties": {"non_hero_expressive_targets": {"minItems": 2}}}}}
    }
  ]
}
